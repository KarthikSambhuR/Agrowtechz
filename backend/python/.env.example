# ─────────────────────────────────────────────────────────────
# Agrowtechz Backend — Active Environment
# ─────────────────────────────────────────────────────────────

# NVIDIA NIM API Key (get yours free at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Model to use via NVIDIA NIM
NVIDIA_MODEL=moonshotai/kimi-k2-instruct

# NVIDIA NIM base URL (do not change)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
